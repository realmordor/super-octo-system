# Copy this file to .env and fill in your credentials
MET_OFFICE_API_KEY=
DARWIN_SFTP_PASS=
DARWIN_STOMP_USER=
DARWIN_STOMP_PASS=

# Optional: minutes to walk from home to Hadley Wood station, for the phone-style
# dashboard's "leave by" countdown (default 10)
WALK_TO_STATION_MINUTES=

# Optional: dim the phone-style dashboard from 22:30 to 06:30 (on by default; set to
# off to start with it off). The moon button on the dashboard switches it per screen.
NIGHT_DIM=
